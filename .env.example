# Copy this file to .env.local and fill in your Supabase project values.
# Get these from: Supabase Dashboard → Project Settings → API

# Public values — safe to expose to the browser (shipped in the client bundle).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Server-only secret — never expose this to the browser, never commit it.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx

# Server-only — powers AI idea shaping (/api/shape-idea). Optional: without it
# the assistant shows a friendly "not configured" message and the manual form
# still works. Get one at https://platform.claude.com
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# --- Map tiles -------------------------------------------------------------
# Unset, the maps use OpenStreetMap's public tiles: free, no account, and
# fine for local work — but their usage policy doesn't cover real traffic,
# and the general-purpose style draws every hospital and car park, which
# competes with our own pins.
#
# Mapbox raster tiles (Leaflet-compatible; Mapbox GL is a different library).
# Style options: light-v11 (quietest), streets-v12, outdoors-v12.
# TILE_SIZE=512 is required — Leaflet assumes 256 and would render every
# label at half scale. The @2x suffix serves retina tiles.
#
# The token is public by definition (NEXT_PUBLIC_*), so restrict it to your
# domains under "URL restrictions" on the Mapbox token page before shipping.
# NEXT_PUBLIC_MAP_TILE_URL=https://api.mapbox.com/styles/v1/mapbox/light-v11/tiles/512/{z}/{x}/{y}@2x?access_token=pk.your_token_here
# NEXT_PUBLIC_MAP_TILE_SIZE=512
# NEXT_PUBLIC_MAP_ATTRIBUTION=&copy; <a href="https://www.mapbox.com/about/maps/">Mapbox</a> &copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>
