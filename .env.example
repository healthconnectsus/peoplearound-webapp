# Copy this file to .env.local and fill in your Supabase project values.
# Get these from: Supabase Dashboard → Project Settings → API

# Public values — safe to expose to the browser (shipped in the client bundle).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Server-only secret — never expose this to the browser, never commit it.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx

# Server-only — powers AI idea shaping (/api/shape-idea). Optional: without it
# the assistant shows a friendly "not configured" message and the manual form
# still works. Get one at https://platform.claude.com
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# --- Map tiles -------------------------------------------------------------
# Unset, the maps use OpenStreetMap's public tiles: free, no account, fine
# for local work — but their usage policy doesn't cover real traffic.
#
# For Mapbox, set the token and (optionally) the style. The tile URL, the
# 512px tile size, the retina suffix and the attribution are all derived —
# there's no long URL to paste, which is what broke the first attempt.
#
# Styles, quietest first:
#   light-v11              muted greys, almost no labels
#   streets-v12            coloured roads, green parks, blue water  (default)
#   outdoors-v12           streets plus terrain and trails
#   navigation-day-v1      high-contrast roads
#   satellite-streets-v12  aerial imagery with labels
#
# The token ships to every browser, so restrict it to your domains under
# "URL restrictions" on the Mapbox token page. Wildcards aren't supported:
# list https://www.peoplearound.com, https://peoplearound.com and
# http://localhost:3000, and leave the vars off Vercel's Preview
# environment so preview deploys fall back to OSM.
# NEXT_PUBLIC_MAPBOX_TOKEN=pk.your_token_here
# NEXT_PUBLIC_MAP_STYLE=streets-v12
#
# Any other raster provider (Stadia, MapTiler, Carto) — full URL instead:
# NEXT_PUBLIC_MAP_TILE_URL=https://…/{z}/{x}/{y}.png
# NEXT_PUBLIC_MAP_TILE_SIZE=256
# NEXT_PUBLIC_MAP_ATTRIBUTION=&copy; <a href="https://example.com">Provider</a>
